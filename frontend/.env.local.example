# Copy this file to .env.local and adjust if your backend runs elsewhere.
#
# The browser only ever calls this frontend's own origin — next.config.ts's
# rewrites() proxies /api/* to the real backend server-to-server, which is
# what makes the auth cookie same-site regardless of where the backend is
# actually hosted. Keep this as a relative path, not a full URL.
NEXT_PUBLIC_API_URL=/api

# REQUIRED — no default. The real backend URL, used only server-side by
# next.config.ts's rewrite (never sent to the browser, unlike
# NEXT_PUBLIC_API_URL above). `next build` calls rewrites() too, so this
# must be set at build time, not just at container runtime — see
# frontend/Dockerfile's BACKEND_API_URL build ARG.
BACKEND_API_URL=http://localhost:8000
